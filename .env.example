# Spotify API Configuration
# Get these values from https://developer.spotify.com/dashboard/applications
NUXT_CLIENT_ID=your_spotify_client_id_here
NUXT_CLIENT_SECRET=your_spotify_client_secret_here

# Application Configuration
# Spotify rejects "localhost" as insecure — use loopback IP 127.0.0.1 for local dev
# For production, use your actual domain
NUXT_BASE_URL=127.0.0.1:3000

# Optional: Environment
NODE_ENV=development